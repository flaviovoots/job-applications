{
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "../dist",

    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "lib": ["es2023"],
    "types": ["node"],

    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["src", "../shared"],
  "exclude": ["../shared/**/*.test.ts"]
}
