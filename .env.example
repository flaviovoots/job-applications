# MongoDB connection string. The database name goes in the path (/jobs_dev here,
# /jobs_prod on Render). Get the user's password from the password manager.
#
# Windows with Node 24.13 or later: if startup fails with "querySrv ECONNREFUSED",
# Node is resolving the SRV record against 127.0.0.1 (a known Node regression;
# check with: node -e "console.log(require('dns').getServers())"). Use the
# non-SRV form locally instead; Render (Linux) keeps the mongodb+srv:// URI:
#   nslookup -type=SRV _mongodb._tcp.<cluster-host>   -> the three shard hosts
#   nslookup -type=TXT <cluster-host>                 -> replicaSet and authSource
# MONGODB_URI=mongodb://jobs-dev:<password>@<shard-00>:27017,<shard-01>:27017,<shard-02>:27017/jobs_dev?tls=true&replicaSet=<replica-set>&authSource=admin&retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://jobs-dev:<password>@<cluster-host>/jobs_dev?retryWrites=true&w=majority

# Signs the session cookie. At least 32 random bytes, for example from:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# The Google OAuth Web client id (created in Stage 2). Also read by the client.
GOOGLE_CLIENT_ID=

# Comma-separated Google accounts allowed to sign in, e.g. you@example.com
ALLOWED_EMAILS=

# Must match the browser's origin exactly. In development that is the Vite dev
# server, whose proxy forwards the browser's Origin header to the API.
APP_ORIGIN=http://localhost:5173

# The API's port. The Vite proxy sends /api and /auth here.
PORT=3000
